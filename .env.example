# Environnement de DÉVELOPPEMENT : copier en .env (jamais commité) puis `docker compose up -d`.
# Ces mots de passe ne servent qu'aux conteneurs locaux, liés à 127.0.0.1.
# Ne jamais réutiliser ces valeurs en production.

# --- Conteneurs ----------------------------------------------------------------
POSTGRES_PASSWORD=postgres_dev
PG_IDENTITY_PASSWORD=identity_dev
PG_TRAVEL_PASSWORD=travel_dev
REDIS_CORE_PASSWORD=core_dev
REDIS_CACHE_PASSWORD=cache_dev

# Ports sur la machine (à changer si déjà pris)
PG_PORT=5432
MONGO_PORT=27017
REDIS_CORE_PORT=6379
REDIS_CACHE_PORT=6380
REDIS_CACHE_MAXMEMORY=128mb

# --- URLs pour les microservices lancés sur la machine (hors Docker) -------------
# Dans un conteneur du même compose, remplacer localhost par le nom du service
# (postgres, mongo, redis-core, redis-cache) et retirer directConnection=true.

# Identity (Prisma) : application et migrations utilisent la même URL en dev
IDENTITY_DATABASE_URL=postgresql://triply_identity:identity_dev@localhost:5432/triply?schema=identity
IDENTITY_DATABASE_URL_DIRECT=postgresql://triply_identity:identity_dev@localhost:5432/triply?schema=identity

# Travel (Prisma)
TRAVEL_DATABASE_URL=postgresql://triply_travel:travel_dev@localhost:5432/triply?schema=travel
TRAVEL_DATABASE_URL_DIRECT=postgresql://triply_travel:travel_dev@localhost:5432/triply?schema=travel

# Assistant (Mongoose). En dev : autoIndex/autoCreate autorisés.
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=assistant

# Redis (deux rôles, voir doc/api/redis/orm.md)
REDIS_CORE_URL=redis://default:core_dev@localhost:6379
REDIS_CACHE_URL=redis://default:cache_dev@localhost:6380
