# Environnement de PRODUCTION (offres gratuites). Copier en .env.production (jamais commité),
# remplir avec les valeurs des consoles, puis suivre doc/infra/bases-de-donnees.md.
# En déploiement, ces valeurs vont dans les secrets de l'hébergeur ou de la CI, pas dans un fichier.
#
# Mots de passe : générer des valeurs longues et aléatoires, par exemple
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- PostgreSQL : Neon (Free, région AWS Europe Central 1 - Frankfurt) --------------
# URL du rôle propriétaire du projet (neondb_owner), connexion DIRECTE (hôte sans -pooler).
# Sert uniquement à pg-bootstrap (création des rôles et schémas). Garder hors des services.
PG_ADMIN_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.eu-central-1.aws.neon.tech/triply?sslmode=require

# Mots de passe choisis pour les rôles applicatifs (créés par pg-bootstrap)
PG_IDENTITY_PASSWORD=CHANGE_ME
PG_TRAVEL_PASSWORD=CHANGE_ME

# Application : hôte -pooler (PgBouncer de Neon), beaucoup de connexions courtes.
# Migrations (prisma migrate deploy) : hôte direct, sans -pooler.
IDENTITY_DATABASE_URL=postgresql://triply_identity:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/triply?sslmode=require&schema=identity
IDENTITY_DATABASE_URL_DIRECT=postgresql://triply_identity:CHANGE_ME@ep-xxxx.eu-central-1.aws.neon.tech/triply?sslmode=require&schema=identity

TRAVEL_DATABASE_URL=postgresql://triply_travel:CHANGE_ME@ep-xxxx-pooler.eu-central-1.aws.neon.tech/triply?sslmode=require&schema=travel
TRAVEL_DATABASE_URL_DIRECT=postgresql://triply_travel:CHANGE_ME@ep-xxxx.eu-central-1.aws.neon.tech/triply?sslmode=require&schema=travel

# --- MongoDB : Atlas (cluster Free, région Europe : Paris ou Frankfurt) ------------
# Utilisateur d'administration (readWrite + dbAdmin sur assistant) : job mongo-init seulement.
MONGO_ADMIN_URL=mongodb+srv://triply_assistant_admin:CHANGE_ME@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# Utilisateur applicatif (readWrite sur assistant) : microservice Assistant.
# En prod : autoIndex: false, autoCreate: false (le job mongo-init crée la structure).
MONGO_URL=mongodb+srv://triply_assistant:CHANGE_ME@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=assistant

# --- Redis --------------------------------------------------------------------------
# redis-core : Upstash (Free, région Europe), éviction DÉSACTIVÉE (défaut Upstash), TLS.
REDIS_CORE_URL=rediss://default:CHANGE_ME@xxxx.upstash.io:6379
# redis-cache : Redis Cloud (Free 30 Mo, région Europe), éviction allkeys-lru.
REDIS_CACHE_URL=redis://default:CHANGE_ME@redis-xxxxx.c1.eu-west-1-1.ec2.redns.redis-cloud.com:12345
